# Shared database
# Use the same DATABASE_URL as apps/web. For Prisma CLI, copy this to packages/db/.env.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Shared auth secret
# Use the same AUTH_SECRET in apps/web and apps/admin.
AUTH_SECRET=""                        # generate: npx auth secret
AUTH_COOKIE_NAMESPACE="admin"         # keeps admin and web browser sessions separate

# Admin OAuth providers
# Add these callback URLs to the OAuth provider dashboards:
# - http://localhost:3001/api/auth/callback/google
# - http://localhost:3001/api/auth/callback/github
# - https://admin.kodevo.id/api/auth/callback/google
# - https://admin.kodevo.id/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin AI diagnostics
ANTHROPIC_API_KEY=""                  # https://console.anthropic.com
GROQ_API_KEY=""                       # fallback jika ANTHROPIC_API_KEY kosong
GROQ_MODEL="llama-3.1-8b-instant"     # opsional
AI_DISABLED=""                        # set "true" untuk matikan semua AI route

# Payment Provider — "stripe" atau "mayar" (default: stripe)
PAYMENT_PROVIDER="stripe"

# Stripe (aktif jika PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=""                  # sk_live_... atau sk_test_...
STRIPE_WEBHOOK_SECRET=""              # whsec_... dari Stripe Dashboard > Webhooks
STRIPE_PRICE_ID=""                    # (legacy) backwards compat — gunakan STRIPE_PLUS_PRICE_ID
STRIPE_PLUS_PRICE_ID=""               # price_... ID harga Plus bulanan
STRIPE_PLUS_ANNUAL_PRICE_ID=""        # price_... ID harga Plus tahunan
STRIPE_PRO_PRICE_ID=""                # price_... ID harga Pro bulanan
STRIPE_PRO_ANNUAL_PRICE_ID=""         # price_... ID harga Pro tahunan

# Mayar (aktif jika PAYMENT_PROVIDER=mayar)
MAYAR_WEBHOOK_SECRET=""               # random string, dipakai di ?secret= pada webhook URL
MAYAR_PLUS_MONTHLY_URL=""             # URL produk Plus bulanan dari Mayar dashboard
MAYAR_PLUS_ANNUAL_URL=""              # URL produk Plus tahunan dari Mayar dashboard
MAYAR_PRO_MONTHLY_URL=""              # URL produk Pro bulanan dari Mayar dashboard
MAYAR_PRO_ANNUAL_URL=""               # URL produk Pro tahunan dari Mayar dashboard
MAYAR_PLUS_MONTHLY_PRICE="99000"      # harga Plus bulanan dalam rupiah (untuk deteksi tier dari webhook)
MAYAR_PLUS_ANNUAL_PRICE="999000"      # harga Plus tahunan dalam rupiah
MAYAR_PRO_MONTHLY_PRICE="199000"      # harga Pro bulanan dalam rupiah
MAYAR_PRO_ANNUAL_PRICE="1799000"      # harga Pro tahunan dalam rupiah

# Email (Resend)
RESEND_API_KEY=""                     # https://resend.com

# Admin app
NEXT_PUBLIC_APP_URL="http://localhost:3001"   # production: https://yourdomain.com
NEXT_PUBLIC_WEB_URL="http://localhost:3000"   # production: https://kodevo.id
ADMIN_BOOTSTRAP_SECRET=""                     # only needed for first admin setup
